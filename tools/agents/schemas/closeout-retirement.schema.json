{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seam.local/schemas/closeout-retirement-v1.json",
  "title": "SEAM Closeout Retirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "authorization_bytes_sha256",
    "authorization_path",
    "kind",
    "missing_request_ids",
    "operator_authority",
    "preserved_commit",
    "preserved_ref",
    "receipt_bytes_sha256",
    "receipt_path",
    "request_bytes_sha256",
    "request_id",
    "request_path",
    "retired_at",
    "review_bytes_sha256",
    "review_path",
    "surviving_receipts"
  ],
  "properties": {
    "schema": {
      "const": "seam-closeout-retirement/v1"
    },
    "authority": {
      "const": "admission_only"
    },
    "authorization_bytes_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorization_path": {
      "pattern": "/retirement-evidence/[0-9a-f]{64}\\.json$",
      "$ref": "#/$defs/path"
    },
    "kind": {
      "enum": [
        "ABANDONED_REQUEST",
        "MISSING_SUPERSESSION_TARGETS"
      ]
    },
    "missing_request_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "operator_authority": {
      "type": "string",
      "pattern": "^HISTORY#[0-9]{1,6}$"
    },
    "preserved_commit": {
      "$ref": "#/$defs/commit"
    },
    "preserved_ref": {
      "type": "string",
      "pattern": "^refs/(heads/main|pull/[0-9]{1,9}/head)$"
    },
    "receipt_bytes_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_path": {
      "oneOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_bytes_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "request_path": {
      "$ref": "#/$defs/path"
    },
    "retired_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_bytes_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "review_path": {
      "pattern": "/retirement-evidence/[0-9a-f]{64}\\.json$",
      "$ref": "#/$defs/path"
    },
    "surviving_receipts": {
      "description": "Exact receipt inventory for each target while its request is absent.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,200}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    }
  }
}
