{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seam.local/schemas/agent-closeout-request-v1.json",
  "title": "SEAM Agent Closeout Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "request_sha256",
    "session_id",
    "created_at",
    "trigger",
    "repo",
    "change_class",
    "context",
    "tdd_evidence",
    "authority",
    "required_checks",
    "receipt_path",
    "request_schema",
    "receipt_schema"
  ],
  "properties": {
    "schema": {"const": "seam-agent-closeout-request/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 180},
    "created_at": {"type": "string", "format": "date-time"},
    "trigger": {"const": "SessionEnd"},
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "cwd",
        "branch",
        "head",
        "base_sha",
        "origin_main",
        "worktree",
        "diff_fingerprint",
        "changed_paths",
        "changed_paths_truncated"
      ],
      "properties": {
        "root": {"type": "string", "minLength": 1, "maxLength": 1000},
        "cwd": {"type": "string", "minLength": 1, "maxLength": 1000},
        "branch": {"type": "string", "minLength": 1, "maxLength": 300},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "origin_main": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$"},
        "worktree": {"type": "string", "minLength": 1, "maxLength": 1000},
        "diff_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changed_paths": {
          "type": "array",
          "maxItems": 512,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "changed_paths_truncated": {"type": "boolean"}
      }
    },
    "change_class": {"enum": ["runtime", "non_runtime"]},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "available", "objective", "plan", "constraints", "affected_tests"],
      "properties": {
        "source": {"const": "root_session_state"},
        "available": {"type": "boolean"},
        "objective": {"type": "string", "maxLength": 1200},
        "plan": {"type": "array", "items": {"type": "string", "maxLength": 500}},
        "constraints": {"type": "array", "items": {"type": "string", "maxLength": 500}},
        "affected_tests": {"type": "array", "items": {"type": "string", "maxLength": 500}}
      }
    },
    "tdd_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtime_paths", "covered_runtime_paths", "missing_runtime_paths", "cycle_count"],
      "properties": {
        "status": {"enum": ["TDD_PROVEN", "TDD_UNPROVEN", "TDD_NOT_REQUIRED"]},
        "runtime_paths": {"type": "array", "items": {"type": "string"}},
        "covered_runtime_paths": {"type": "array", "items": {"type": "string"}},
        "missing_runtime_paths": {"type": "array", "items": {"type": "string"}},
        "cycle_count": {"type": "integer", "minimum": 0}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_writes", "forbidden_actions"],
      "properties": {
        "mode": {"const": "verify_only"},
        "allowed_writes": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "receipt_path": {"type": "string", "minLength": 1, "maxLength": 1000},
    "request_schema": {"const": "tools/agents/schemas/closeout-request.schema.json"},
    "receipt_schema": {"const": "tools/agents/schemas/closeout-receipt.schema.json"}
  }
}
