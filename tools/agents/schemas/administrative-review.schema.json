{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seam.local/schemas/closeout-administrative-review-v1.json",
  "title": "SEAM Closeout Administrative Review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "repository_common_dir", "queue_root", "current_request_id",
    "current_request_sha256", "current_receipt_sha256", "prior_request_id",
    "prior_request_sha256", "prior_receipt_sha256", "producer_session_id",
    "reviewer", "reviewed_at", "status", "reason", "authority",
    "unresolved_findings"
  ],
  "properties": {
    "schema": {"const": "seam-closeout-administrative-review/v1"},
    "repository_common_dir": {"$ref": "#/$defs/path"},
    "queue_root": {"$ref": "#/$defs/path"},
    "current_request_id": {"$ref": "#/$defs/id"},
    "current_request_sha256": {"$ref": "#/$defs/sha256"},
    "current_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "prior_request_id": {"$ref": "#/$defs/id"},
    "prior_request_sha256": {"$ref": "#/$defs/sha256"},
    "prior_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "producer_session_id": {"$ref": "#/$defs/id"},
    "reviewer": {"$ref": "#/$defs/id"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "status": {"const": "PASS"},
    "reason": {"const": "UNCHANGED_NONRUNTIME_TAIL_ASSURANCE_BOUNDARY"},
    "authority": {"const": "admission_only"},
    "unresolved_findings": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,200}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1000},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
