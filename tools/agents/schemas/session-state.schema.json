{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seam.local/schemas/agent-session-state-v1.json",
  "title": "SEAM Root Session State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "base_sha",
    "objective",
    "plan",
    "constraints",
    "affected_tests",
    "tdd_cycles"
  ],
  "properties": {
    "schema": {"const": "seam-agent-session-state/v1"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 180},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "plan": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "constraints": {
      "type": "array",
      "maxItems": 24,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "affected_tests": {
      "type": "array",
      "maxItems": 128,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "tdd_cycles": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior", "test_refs", "implementation_refs", "red", "green"],
        "properties": {
          "behavior": {"type": "string", "minLength": 1, "maxLength": 1000},
          "test_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "implementation_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "red": {"$ref": "#/$defs/phase"},
          "green": {"$ref": "#/$defs/phase"}
        }
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "observed_at", "fingerprint"],
      "properties": {
        "command": {"type": "string", "minLength": 1, "maxLength": 2000},
        "exit_code": {"type": "integer"},
        "observed_at": {"type": "string", "format": "date-time"},
        "fingerprint": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
