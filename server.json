{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Canticle-AI-Research/seam-suite",
  "description": "SEAM Suite: self-hosted agent memory with local retrieval and provenance over MCP. Early access.",
  "repository": {
    "url": "https://github.com/Canticle-AI-Research/Seam",
    "source": "github"
  },
  "version": "2.4.1rc1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "seam-suite",
      "version": "2.4.1rc1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--default-index",
          "value": "https://pypi.org/simple"
        },
        {
          "type": "positional",
          "value": "--from"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "seam-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SEAM_DB_PATH",
          "description": "Path to the local SQLite memory database. Defaults to a per-user data directory if unset.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
