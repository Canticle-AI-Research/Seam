/* SEAM TUI — Canticle style.
 *
 * Canticle's visual contract is "Charm / Lipgloss TUI + dense ASCII", so the
 * terminal UI and the website share one palette rather than merely rhyming:
 * every colour below is the literal token from Canticle.cc `styles.css`
 * (Tokyo Night base + Charm pastels). Panels follow `.tui-box` — rounded
 * border, panel-dark fill, magenta uppercase title — and the prompt is `❯`.
 *
 * Kept deliberately: rounded borders everywhere, one saturated accent for
 * focus, a dim help rail pinned to the bottom.
 */

/* ── Tokyo Night base ─────────────────────────────────── */
$bg: #1a1b26;
$bg-deep: #16161e;
$bg-panel: #1f2028;
$bg-sunk: #13131a;
$surface-alt: #24253a;

/* ── Charm pastels ────────────────────────────────────── */
$pink: #ff6090;
$magenta: #e478d0;
$lavender: #c4a7e7;
$cyan: #7dcfff;
$mint: #9ece6a;
$green: #73daca;
$yellow: #e0af68;
$orange: #ff9e64;
$red: #f7768e;
$blue: #7aa2f7;
$ice: #b4f9f8;

/* ── Text + chrome ────────────────────────────────────── */
$text-main: #c0caf5;
$text-dim: #565f89;
$text-muted: #a9b1d6;
$edge: #3b3d57;
$edge-hi: #565f89;

Screen {
    background: $bg;
    color: $text-main;
    layers: base overlay;
}

/* ── Brand rail ───────────────────────────────────────── */

#brand-rule {
    height: 1;
    background: $bg-deep;
    overflow: hidden;
}

#brand-bar {
    height: 3;
    padding: 0 2;
    background: $bg-deep;
    border-bottom: solid $edge;
}

#brand-lockup {
    height: 3;
    width: auto;
}

#brand-symbol, #startup-symbol {
    width: 8;
    height: 3;
    min-width: 8;
    border: round $pink;
    background: #0a0b0a;
    content-align: center middle;
    text-style: bold;
}

#brand-product {
    width: 7;
    height: 3;
    padding: 1 1 0 1;
    color: $pink;
    text-style: bold;
}

#brand-context {
    color: $text-dim;
    width: 1fr;
    padding: 1 1 0 1;
    text-overflow: ellipsis;
}

#brand-mode {
    width: auto;
    padding: 1 2 0 0;
    color: $text-muted;
    text-style: bold;
}

#brand-status {
    width: 10;
    height: 3;
    padding: 1 2 0 2;
    color: $green;
    background: $bg-panel;
    border: round $edge;
}

/* ── Launch lockup ────────────────────────────────────── */

#startup-splash {
    dock: top;
    layer: overlay;
    width: 100%;
    height: 100%;
    align: center middle;
    background: $bg-deep;
}

#startup-word {
    width: 10;
    height: 3;
    padding: 1 0 0 1;
    color: $pink;
    text-style: bold;
}

/* ── Tabs ─────────────────────────────────────────────── */

TabbedContent {
    height: 1fr;
}

TabbedContent Tabs {
    background: $bg-deep;
    color: $text-dim;
}

TabbedContent Tabs Tab {
    padding: 0 2;
    color: $text-dim;
    text-style: bold;
}

TabbedContent Tabs Tab:hover {
    color: $cyan;
}

TabbedContent Tabs Tab.-active {
    color: $magenta;
    text-style: bold;
}

TabbedContent Tabs Underline > .underline--bar {
    color: $magenta;
}

TabPane {
    padding: 1 2;
    background: $bg;
}

/* ── Panels (.tui-box) ────────────────────────────────── */

.panel {
    border: round $edge;
    background: $bg-panel;
    padding: 1 2;
}

.panel:focus-within {
    border: round $magenta;
}

.panel-title {
    color: $magenta;
    text-style: bold;
    padding: 0 0 1 0;
}

DataTable {
    background: $bg-panel;
    border: round $edge;
    height: 1fr;
}

DataTable:focus {
    border: round $magenta;
}

DataTable > .datatable--header {
    background: $surface-alt;
    color: $lavender;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $magenta;
    color: $bg-deep;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $surface-alt;
}

/* ── Memory page (records + provenance-below + log) ──── */
/*
 * `MemoryPanel` (panels.py) stacks three sections in one Vertical: the
 * records table, the provenance trace, and the tab's RichLog. Each of the
 * first two is itself a container (`MemoryRecordsPanel`, `ProvPanel`), not
 * a bare widget, so without explicit heights here they fall back to
 * `height: auto` and the whole page collapses toward whichever child's
 * *content* is tallest instead of sharing the tab's real vertical space --
 * confirmed by capturing real tmux frames (task brief step G) before these
 * rules existed. `1fr` on both halves plus a `min-height` keeps a usable
 * number of rows visible at small terminal sizes without letting either
 * section starve the other; the log is fixed small since it is transcript,
 * not the thing being searched.
 */

#memory-records {
    height: 1fr;
    min-height: 8;
}

#memory-prov {
    height: 1fr;
    min-height: 7;
}

#memory-id-controls {
    height: 3;
}

#prov-query {
    width: 1fr;
}

#memory-copy-id {
    width: 14;
    min-width: 14;
    margin-left: 1;
    padding: 0 1;
}

/*
 * Fixed, and deliberately small: this is transcript, not the thing being
 * searched. The exact numbers are a floor, not taste -- the three sections
 * plus the brand bar, tab bar, command input and help rail have to fit a
 * short terminal, and at 110x32 an 8-row log with an 8-row prov floor
 * pushed the log entirely off-screen, so command output landed somewhere
 * invisible. These floors keep all three visible down to ~30 rows.
 */
#log-memory {
    height: 6;
    min-height: 4;
}

/* `Tree` carries no border by default, unlike `DataTable` above -- without
 * this the provenance trace reads as loose text floating under the records
 * table instead of the other half of one system. */
#prov-tree {
    border: round $edge;
    background: $bg-panel;
    height: 1fr;
    min-height: 4;
}

#prov-tree:focus {
    border: round $magenta;
}

/* ── Command palette (the "/" menu) ───────────────────── */

#palette-wrap {
    layer: overlay;
    align: center top;
    width: 100%;
    height: 100%;
    background: $bg-sunk 70%;
}

#palette {
    width: 80%;
    max-width: 96;
    height: auto;
    max-height: 24;
    margin-top: 4;
    border: round $magenta;
    background: $bg-panel;
    padding: 1 2;
}

#palette-prompt {
    color: $magenta;
    text-style: bold;
    padding: 0 0 1 0;
}

#palette-input {
    border: none;
    background: $bg-panel;
    padding: 0;
    color: $text-main;
}

#palette-input:focus {
    border: none;
}

#palette-list {
    height: auto;
    max-height: 16;
    background: $bg-panel;
    border: none;
    padding: 1 0 0 0;
}

#palette-list > .option-list--option {
    padding: 0 1;
    color: $text-muted;
}

#palette-list > .option-list--option-highlighted {
    background: $magenta;
    color: $bg-deep;
    text-style: bold;
}

#palette-list:focus > .option-list--option-highlighted {
    background: $magenta;
    color: $bg-deep;
    text-style: bold;
}

#palette-empty {
    color: $text-dim;
    padding: 1 0;
}

/* ── Settings ─────────────────────────────────────────── */

#settings-workspace {
    height: 1fr;
    background: $bg-deep;
}

#settings-list-pane {
    width: 25;
    min-width: 18;
    max-width: 45;
    padding: 1;
    background: $bg-deep;
}

#settings-section-list {
    height: 1fr;
    background: $bg-deep;
}

SettingsSectionItem {
    height: 3;
    padding: 1 1 0 1;
    color: $text-muted;
}

SettingsSectionItem.-highlight,
SettingsSectionItem:hover {
    background: $bg-panel;
    color: $text-main;
}

#settings-divider {
    width: 1;
    min-width: 1;
    height: 1fr;
    background: $edge;
    color: $edge-hi;
    content-align: center middle;
}

#settings-divider:hover, #settings-divider:focus,
#settings-divider.-dragging {
    background: $cyan;
    color: $bg-deep;
}

#settings-detail-pane {
    width: 1fr;
    min-width: 48;
    padding: 1 2;
}

#settings-section-title {
    height: 2;
    color: $text-main;
    text-style: bold;
}

#settings-body {
    height: 1fr;
}

.settings-section {
    height: auto;
}

#settings-search {
    width: 40;
    border: round $edge;
    background: $bg-panel;
    margin: 0 0 1 0;
}

#settings-search:focus {
    border: round $magenta;
}

.settings-group {
    color: $magenta;
    text-style: bold;
    padding: 1 0 0 0;
}

.settings-row {
    height: auto;
    padding: 0 0 1 0;
}

.settings-name {
    width: 38;
    color: $text-main;
}

.settings-name-secret {
    width: 38;
    color: $yellow;
}

.settings-input {
    width: 1fr;
    border: round $edge;
    background: $bg-sunk;
    padding: 0 1;
    color: $text-main;
}

.settings-input:focus {
    border: round $magenta;
}

.settings-input.-invalid {
    border: round $red;
}

.settings-help {
    color: $text-dim;
    padding: 0 0 0 40;
}

.settings-error {
    color: $red;
    padding: 0 0 0 40;
}

.badge-env {
    color: $mint;
    width: 9;
}

.badge-file {
    color: $cyan;
    width: 9;
}

.badge-default {
    color: $text-dim;
    width: 9;
}

.badge-unset {
    color: $edge;
    width: 9;
}

#settings-actions {
    height: auto;
    padding: 1 0 0 0;
}

#settings-status {
    color: $text-muted;
    padding: 1 0 0 2;
    width: 1fr;
}

/* ── Buttons (terminal command keys, not SaaS pills) ──── */

Button {
    border: round $edge;
    background: $bg-panel;
    color: $text-muted;
    padding: 0 2;
    height: 3;
}

Button:hover {
    border: round $cyan;
    color: $cyan;
}

Button.-primary {
    border: round $magenta;
    color: $magenta;
    text-style: bold;
}

Button.-danger {
    border: round $red;
    color: $red;
}

/* ── Help rail ────────────────────────────────────────── */

#help-rail {
    display: none;
}

.key {
    color: $lavender;
    text-style: bold;
}

/* ── Output surfaces ──────────────────────────────────── */

#result-title {
    color: $magenta;
    text-style: bold;
}

RichLog {
    background: $bg-panel;
    border: round $edge;
    padding: 0 1;
    color: $text-main;
}

RichLog:focus {
    border: round $magenta;
}

Input {
    border: round $edge;
    background: $bg-sunk;
    color: $text-main;
}

Input:focus {
    border: round $magenta;
}

#command-input {
    width: 1fr;
    height: 3;
    border: none;
    background: transparent;
}

#command-input:focus {
    border: none;
}

#command-bar {
    height: 3;
    padding: 0 1;
    background: $bg-deep;
    border-top: solid $edge;
}

#command-sigil {
    width: 3;
    height: 3;
    content-align: center middle;
}

#command-bar Button {
    height: 3;
    width: auto;
    margin-left: 1;
}

/* Input-mode indicator (S2b Part 1) -- the third of the three places the
 * mode must be visible, alongside `#brand-mode` above and the input's own
 * placeholder text. Seam mode keeps the default pink-on-focus border above;
 * shell and chat each get their own colour so the border reads as "which
 * mode is this" even before the placeholder text is read. `:focus` variants
 * repeat the colour so it does not get overridden by `#command-input:focus`
 * above while the field still has focus, which is most of the time.
 */
#command-input.-mode-shell {
    border: round $orange;
}

#command-input.-mode-shell:focus {
    border: round $orange;
}

/* Shell mode latched while `SEAM_DASHBOARD_ALLOW_SHELL` is off (the gate
 * added alongside this posture, see `shell.py`'s module docstring): a
 * distinct red border keeps the disabled state visible even before the
 * operator reads the placeholder text or the `#brand-mode` indicator.
 */
#command-input.-mode-shell-disabled {
    border: round $red;
}

#command-input.-mode-shell-disabled:focus {
    border: round $red;
}

#command-input.-mode-chat {
    border: round $cyan;
}

#command-input.-mode-chat:focus {
    border: round $cyan;
}

Select {
    background: $bg-sunk;
}

Select > SelectCurrent {
    border: round $edge;
    background: $bg-sunk;
    color: $text-main;
}

Select:focus > SelectCurrent {
    border: round $magenta;
}

Switch {
    background: $bg-sunk;
    border: round $edge;
}

Switch > .switch--slider {
    color: $edge-hi;
    background: $bg-sunk;
}

Switch.-on > .switch--slider {
    color: $mint;
}

Toast {
    border: round $magenta;
    background: $bg-panel;
}

Tooltip {
    background: $surface-alt;
    color: $text-main;
    border: round $edge;
}

/* ── Canticle rework: nav rail + sections + overlay drawers ── */
/*
 * The IA rework replaces the TabbedContent strip with a left nav rail
 * (nav.py), a ContentSwitcher of five section pages, and three docked
 * right overlays (overlays.py). Page widgets keep `panel-{id}` ids so
 * app.py's switching/refresh contract is unchanged.
 */

#app-body {
    height: 1fr;
}

#sections {
    width: 1fr;
    height: 1fr;
}

#panel-memory, #panel-retrieval, #panel-benchmarks,
#panel-compression, #panel-settings {
    height: 1fr;
}

/* Nav rail rows */

#nav-list {
    height: 1fr;
}

NavRailItem {
    height: 4;
    layout: horizontal;
    padding: 0 1;
}

NavRailItem.-active {
    background: $surface-alt;
    border-left: thick $magenta;
}

.nav-hotkey {
    width: 2;
    color: $text-dim;
    text-style: bold;
}

.nav-glyph {
    width: 4;
    margin: 0 1 0 0;
    text-style: bold;
}

.nav-label {
    width: 12;
    text-style: bold;
}

.nav-summary {
    width: 1fr;
    color: $text-dim;
}

#nav-hints {
    height: 2;
    color: $text-dim;
    padding: 0 1;
}

#nav-help {
    width: 1fr;
    margin: 0 1 1 1;
}

/* Shared page furniture */

.pane-label {
    height: 1;
    color: $text-dim;
    text-style: bold;
}

.page-title {
    height: 1;
    color: $magenta;
    text-style: bold;
}

.page-subtitle {
    height: 1;
    color: $text-dim;
}

/* Memory page: list pane (left) + detail pane (right) */

#memory-list-pane {
    width: 55;
    min-width: 35;
    max-width: 90;
    background: $bg-deep;
}

#memory-detail-pane {
    width: 1fr;
    min-width: 40;
    padding: 1 2;
    background: $bg-deep;
}

#memory-view-toggle, #detail-mode-toggle {
    height: 3;
    padding: 0 1;
}

#memory-search {
    margin: 0 1;
}

#memory-divider {
    width: 1;
    min-width: 1;
    height: 1fr;
    background: $edge;
    color: $edge-hi;
    content-align: center middle;
}

#memory-divider:hover, #memory-divider:focus,
#memory-divider.-dragging {
    background: $cyan;
    color: $bg-deep;
}

#memory-graph-pane {
    height: 1fr;
    min-height: 8;
    display: none;
    background: $bg-sunk;
}

#graph-toolbar {
    height: 6;
    background: $bg-deep;
    border-bottom: solid $edge;
}

#graph-controls, #graph-layout-controls {
    height: 3;
    padding: 0 1;
    background: $bg-deep;
}

#graph-controls Button, #graph-layout-controls Button {
    height: 3;
    min-width: 3;
    width: auto;
    margin: 0 1 0 0;
}

#graph-layout-controls Button.-active {
    border: round $cyan;
    color: $cyan;
    background: $bg-panel;
}

#graph-layout-controls Button {
    margin: 0;
}

#layout-force {
    width: 12;
}

#layout-tree {
    width: 11;
}

#layout-constellation {
    width: 1fr;
}

#graph-zoom-label {
    width: 6;
    height: 3;
    content-align: center middle;
    color: $text-dim;
}

#graph-gesture-hint {
    display: none;
}

#graph-help {
    height: 1;
    padding: 0 1;
    color: $text-dim;
    background: $bg-deep;
}

#constellation-graph {
    height: 1fr;
    min-height: 8;
    background: $bg-sunk;
    color: $text-main;
    overflow: hidden;
}

#constellation-graph:focus {
    border: solid $cyan;
}

#detail-header {
    height: 3;
}

#detail-kind {
    width: auto;
    margin: 0 1 0 0;
}

#detail-id {
    width: 1fr;
}

#detail-meta {
    height: 1;
    color: $text-dim;
}

#detail-record-pane {
    height: auto;
    max-height: 18;
    min-height: 6;
}

#detail-mirl-pane {
    height: 1fr;
    min-height: 6;
}

#detail-mirl-pane {
    display: none;
}

#detail-attrs {
    height: auto;
    max-height: 13;
    min-height: 4;
}

#detail-summary {
    height: auto;
    min-height: 3;
    max-height: 6;
    padding: 1 2;
    margin: 0 0 1 0;
    border-left: thick $mint;
    background: $bg-panel;
    color: $text-main;
}

#detail-mirl {
    height: 1fr;
    min-height: 4;
}

#memory-prov {
    height: 1fr;
    min-height: 8;
}

#prov-tree {
    height: 1fr;
    min-height: 5;
}

/* Retrieval page: score cards + status grid + timeline */

#retrieval-scores {
    height: 7;
    margin: 0 0 1 0;
}

#retrieval-scores > Vertical, .status-row > Vertical {
    border: round $edge;
    background: $bg-panel;
    padding: 0 1;
}

.score-label {
    height: 1;
    color: $text-dim;
    text-style: bold;
}

.score-value {
    height: 3;
    color: $text-main;
    text-style: bold;
}

.score-trend {
    height: 1;
    color: $text-dim;
}

.status-row {
    height: 5;
    margin: 0 0 1 0;
}

.status-label {
    height: 1;
    color: $text-dim;
}

.status-value {
    height: 1;
}

.status-detail {
    height: 1;
    color: $text-dim;
}

.timeline {
    height: auto;
    max-height: 12;
    padding: 0 1;
}

/* Chat drawer */

#chat-header, #drawer-header, #connections-header {
    height: 3;
}

#chat-title, #drawer-title, #connections-title {
    width: 1fr;
    text-style: bold;
}

#chat-model-line {
    height: 1;
    color: $text-dim;
    padding: 0 1;
}

#chat-log {
    height: 1fr;
}

#chat-input-row {
    height: 3;
}

#chat-draft {
    width: 1fr;
}

/* Memories drawer */

#drawer-count {
    height: 1;
    padding: 0 1;
}

#drawer-activity {
    height: auto;
    max-height: 8;
    padding: 0 1;
    color: $text-dim;
}

#drawer-filter {
    height: 3;
}

#drawer-filter-hint {
    height: 1;
    color: $text-dim;
    padding: 0 1;
}

#drawer-records {
    height: 1fr;
}

.drawer-record-id {
    height: 1;
    text-style: bold;
}

.drawer-record-preview {
    height: 1;
    color: $text-muted;
}

.drawer-record-meta {
    height: 1;
    color: $text-dim;
}

/* Connections popover */

#connections-body {
    padding: 0 1;
}

/* App-level surfaces */

#app-log {
    display: none;
    height: 6;
    min-height: 4;
    border-top: solid $edge;
    background: $bg-deep;
}

#app-log.-open {
    display: block;
}

#topbar-chat, #topbar-memories, #topbar-connections, #topbar-log {
    margin-left: 1;
}

/* Compact terminals keep both halves of Memory usable by collapsing the
 * rail to its hotkey + glyph instead of clipping the detail pane off-screen. */
Screen.-compact NavRail {
    width: 12;
    padding: 1 0 0 0;
}

Screen.-compact NavRailItem {
    padding: 0 1;
}

Screen.-compact .nav-label, Screen.-compact .nav-summary {
    display: none;
}

Screen.-compact .nav-glyph {
    width: 3;
    margin: 0;
}

Screen.-compact #nav-hints {
    display: none;
}

Screen.-compact #nav-help {
    margin: 0 0 1 0;
    padding: 0;
}

Screen.-compact #memory-list-pane,
Screen.-compact #memory-detail-pane {
    min-width: 34;
}

Screen.-compact #memory-list-pane {
    width: 44;
}

Screen.-compact #graph-gesture-hint {
    display: none;
}

Screen.-compact #layout-force,
Screen.-compact #layout-tree {
    display: none;
}
