__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
*.db
*.db-wal
*.db-shm
*.db-journal
.seam-runtime-*.lock
*.seam-backups/
test_seam/
.seam_chroma/
exports/

# Local benchmark run outputs at repo root (operator-driven smokes)
/run_*.json

# Conversation logs
conversations/
*.conversation
*.jsonl
!benchmarks/fixtures/wandr/*.replay.jsonl

# Secrets and credentials - NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
credentials.json
service_account.json
config.local.*
*.secret
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
.ssh/

# Provisioned self-host inputs and local image archives
selfhost/entitlement.json
selfhost/api-token.txt
selfhost/*.tar
selfhost/*.oci

# Operator-local agent config (Codex/Claude/etc.) — never tracked
seam_runtime/config.toml

# Local agent/tooling state
.claude/
.lingma/
.ua/
.pytest_cache/
build/
archive/code/generated-build*/
seam_runtime/_handoff_20260419/

# Derived snapshot payloads (keep directory marker only)
.seam/snapshots/*.json
.seam/surfaces/
# Local orchestration state. Schemas and profiles remain tracked elsewhere.
.seam/orchestration/context/
.seam/orchestration/sessions/
.seam/orchestration/session-end/requests/
.seam/orchestration/session-end/receipts/
.seam/orchestration/session-end/receipt-attempts/
.context-handoffs/

# Local editor and agent config
.cursor/
.vscode/
.gemini/
.opencode/package.json
.opencode/package-lock.json

# Generated surface artifacts
*.seam.png

# Local artifact dumps
Webui-final-dash/
diag_out/
/dist/
/report-*.png
# Browser/tooling caches (Playwright MCP screenshots+logs, Wrangler cache)
.playwright-mcp/
.wrangler/
# Generated handoff/scoreboard visualizations (local presentation material, regenerable)
visuals/
# One-off local screenshots / page snapshots
gated-view.png
mem0-harness-scoreboard.png
page-snapshot.md

# Publish-only benchmark material stays local unless intentionally released
benchmarks/fixtures/holdout/*.json
!benchmarks/fixtures/holdout/*.example.json
benchmarks/runs/holdout/*.json
# Durable LoCoMo result bundles: persisted on disk (not /tmp) but operator-controlled, kept out of git
benchmarks/runs/locomo/*.json
# Full per-case run records (rich JSON + training JSONL): bulky run artifacts, operator-controlled, kept out of git
benchmarks/runs/records/
# Local durable benchmark dataset copies (redundant with the in-repo committed copy; do not double-commit)
.dataset_store/
