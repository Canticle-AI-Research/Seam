{
  "description": "SEAM project hooks. User-global hooks remain additive.",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 tools/agents/session_end_closeout.py",
            "timeout": 10,
            "statusMessage": "Queueing bounded SEAM closeout verification"
          }
        ]
      }
    ]
  }
}
